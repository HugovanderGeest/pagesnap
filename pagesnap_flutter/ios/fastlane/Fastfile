default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Standard Fastlane setup for CI environments (creates and unlocks a temporary keychain)
    setup_ci
    
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT_BASE64"],
      is_key_content_base64: true,
      in_house: false
    )

    # Use `match` (preferred) when a Match git repo is provided to avoid creating
    # new distribution certificates on the Apple Developer account (Apple limits).
    # Set `MATCH_GIT_URL` and optionally `MATCH_READONLY` in CI secrets.
    if ENV['MATCH_GIT_URL'] && !ENV['MATCH_GIT_URL'].empty?
      match(
        type: 'appstore',
        git_url: ENV['MATCH_GIT_URL'],
        readonly: ENV['MATCH_READONLY'] == 'true',
        app_identifier: [ENV['APP_IDENTIFIER'] || 'one.peruse.app'],
        keychain_name: ci_keychain,
        keychain_password: ENV['KEYCHAIN_PASSWORD']
      )
    else
      # Fallback: try to create/fetch certs (may fail if account reached cert limits)
      cert(
        keychain_path: ENV["MATCH_KEYCHAIN_NAME"],
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
      )
      sigh(
        keychain_path: ENV["MATCH_KEYCHAIN_NAME"]
      )
    end
    
    # Run flutter build (no codesign here; Xcode will sign during export)
    sh("cd ../.. && flutter build ios --release --no-codesign")

    # Build the workspace — pass explicit signing args to avoid interactive prompts
    # Only include PROVISIONING_PROFILE_SPECIFIER if SIGH_PROFILE_ID is provided.
    xcargs = "CODE_SIGN_IDENTITY='Apple Distribution'"
    if ENV['SIGH_PROFILE_ID'] && !ENV['SIGH_PROFILE_ID'].empty?
      xcargs += " PROVISIONING_PROFILE_SPECIFIER='#{ENV['SIGH_PROFILE_ID']}'"
    end

    build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      output_directory: "build",
      export_method: "app-store",
      xcargs: xcargs,
      clean: true,
      verbose: true
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
